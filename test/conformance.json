  "reconnect": {
    "windowMs": 30000,
    "limit": 2,
    "calls": [
      {
        "at": 0,
        "expect": true
      },
      {
        "at": 1000,
        "expect": true
      },
      {
        "at": 2000,
        "expect": false
      },
      {
        "at": 29999,
        "expect": false
      },
      {
        "at": 31001,
        "expect": true
      },
      {
        "at": 31002,
        "expect": true
      },
      {
        "at": 31003,
        "expect": false
      },
      {
        "at": 62000,
        "expect": true
      }
    ]
  },
  "unread": {
    "about": "Section 7. requests: the address and Authorization header an SDK asks with, from the stored origin and token. answers: what the SDK does with each answer: show the count, forget the token, or keep the badge as it was. guard: every automatic check shares one guard, at most one per intervalMs (the first always). expiry: whether a stored token is still used (now < expiresAt, milliseconds since 1970).",
    "requests": [
      {
        "origin": "https://ticketrackr.com",
        "token": "trk_unread_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQ",
        "expect": {
          "url": "https://ticketrackr.com/api/support/unread",
          "authorization": "Bearer trk_unread_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQ"
        }
      },
      {
        "origin": "http://localhost:3219",
        "token": "trk_unread_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQ",
        "expect": {
          "url": "http://localhost:3219/api/support/unread",
          "authorization": "Bearer trk_unread_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQ"
        }
      }
    ],
    "answers": [
      {
        "status": 200,
        "body": "{\"unread\": 2}",
        "expect": {
          "result": "count",
          "count": 2
        }
      },
      {
        "status": 200,
        "body": "{\"unread\": 0}",
        "expect": {
          "result": "count",
          "count": 0
        }
      },
      {
        "status": 200,
        "body": "{\"unread\": 3, \"extra\": true}",
        "expect": {
          "result": "count",
          "count": 3
        }
      },
      {
        "status": 200,
        "body": "{\"unread\": -1}",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 200,
        "body": "{\"unread\": 1.5}",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 200,
        "body": "{\"unread\": \"2\"}",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 200,
        "body": "{}",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 200,
        "body": "nope",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 401,
        "body": "{\"message\": \"Open support again from your application.\"}",
        "expect": {
          "result": "forget"
        }
      },
      {
        "status": 403,
        "body": "{}",
        "expect": {
          "result": "forget"
        }
      },
      {
        "status": 429,
        "body": "{}",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 500,
        "body": "{\"unread\": 2}",
        "expect": {
          "result": "keep"
        }
      },
      {
        "status": 503,
        "body": "{}",
        "expect": {
          "result": "keep"
        }
      }
    ],
    "guard": {
      "intervalMs": 60000,
      "calls": [
        {
          "at": 0,
          "expect": true
        },
        {
          "at": 30000,
          "expect": false
        },
        {
          "at": 59999,
          "expect": false
        },
        {
          "at": 60000,
          "expect": true
        },
        {
          "at": 60001,
          "expect": false
        },
        {
          "at": 200000,
          "expect": true
        }
      ]
    },
    "expiry": [
      {
        "expiresAt": 2000,
        "now": 1999,
        "expect": true
      },
      {
        "expiresAt": 2000,
        "now": 2000,
        "expect": false
      },
      {
        "expiresAt": 2000,
        "now": 5000,
        "expect": false
      }
    ]
  }
}
