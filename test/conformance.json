  ],
  "reconnect": {
    "windowMs": 30000,
    "limit": 2,
    "calls": [
      {
        "at": 0,
        "expect": true
      },
      {
        "at": 1000,
        "expect": true
      },
      {
        "at": 2000,
        "expect": false
      },
      {
        "at": 29999,
        "expect": false
      },
      {
        "at": 31001,
        "expect": true
      },
      {
        "at": 31002,
        "expect": true
      },
      {
        "at": 31003,
        "expect": false
      },
      {
        "at": 62000,
        "expect": true
      }
    ]
  }
}
